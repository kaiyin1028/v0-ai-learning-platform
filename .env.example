# ===========================================
# LearnAI - 環境變數設定範本
# ===========================================
# 複製此檔案為 .env.local 並填入你的設定值
# cp .env.example .env.local

# -------------------------------------------
# 資料庫設定
# -------------------------------------------
# PostgreSQL 連線字串
# 格式: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://learnai:your_password@localhost:5432/learnai_db"

# -------------------------------------------
# 認證設定
# -------------------------------------------
# NextAuth 密鑰 (請使用隨機字串)
# 生成方式: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-please-change-in-production"

# 應用程式 URL
NEXTAUTH_URL="http://localhost:3000"

# -------------------------------------------
# AI 服務設定
# -------------------------------------------
# OpenAI API 金鑰
OPENAI_API_KEY="sk-your-openai-api-key"

# OpenAI API 基礎 URL (可選，用於自建或代理服務)
# OPENAI_BASE_URL="https://api.openai.com/v1"

# 預設 AI 模型
DEFAULT_AI_MODEL="gpt-4o-mini"

# -------------------------------------------
# 圖片生成設定 (可選)
# -------------------------------------------
# Stability AI API 金鑰 (用於圖片生成)
# STABILITY_API_KEY="sk-your-stability-api-key"

# FAL AI API 金鑰 (用於圖片生成)
# FAL_KEY="your-fal-api-key"

# -------------------------------------------
# 檔案儲存設定 (可選)
# -------------------------------------------
# Vercel Blob 存取令牌
# BLOB_READ_WRITE_TOKEN="vercel_blob_your_token"

# 或使用 S3 相容儲存
# S3_BUCKET="your-bucket-name"
# S3_REGION="ap-northeast-1"
# S3_ACCESS_KEY="your-access-key"
# S3_SECRET_KEY="your-secret-key"

# -------------------------------------------
# 學校設定
# -------------------------------------------
# 學校名稱 (顯示在 UI 上)
SCHOOL_NAME="示範中學"

# 學校代碼
SCHOOL_CODE="DEMO"

# -------------------------------------------
# 功能開關
# -------------------------------------------
# 是否啟用 Agent 市集
ENABLE_MARKETPLACE="true"

# 是否啟用圖片生成
ENABLE_IMAGE_GENERATION="true"

# 是否啟用圖片編輯
ENABLE_IMAGE_EDITING="true"

# -------------------------------------------
# 限制設定
# -------------------------------------------
# 學生每日對話次數上限
STUDENT_DAILY_CHAT_LIMIT="100"

# 學生每月圖片生成上限
STUDENT_MONTHLY_IMAGE_LIMIT="50"

# -------------------------------------------
# 開發設定
# -------------------------------------------
# Node 環境
NODE_ENV="development"

# 是否顯示除錯資訊
DEBUG="false"
